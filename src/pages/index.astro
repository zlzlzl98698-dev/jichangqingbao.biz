---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandLogo from '../components/brands/BrandLogo.astro';
import BrandCard from '../components/brands/BrandCard.astro';
import TimelineList from '../components/intelligence/TimelineList.astro';
import { PRIMARY_NAV } from '../data/navigation';
import {
  brands,
  plans,
  testResults,
  clients,
  intelligenceEvents,
  dataConflicts,
  getFeaturedBrands,
  getBrandsSortedByPriority,
  getEntryPlan,
  getStatusBadgeStyle,
  SITE_META,
} from '../lib/data';

const featuredBrands = getFeaturedBrands();
const allBrands = getBrandsSortedByPriority();
const lightspeed = allBrands.find((b) => b.slug === 'guangsuyun')!;
const testedBrandsCount = brands.filter((b) => b.testImages.length > 0 || b.historicalTests.length > 0).length;
const noExpiryPlansCount = plans.filter((p) => p.billingCycle === '一次性付费').length;
---

<BaseLayout
  title="机场情报 — 机场品牌档案、风险情报与专业评测 | jichangqingbao.biz"
  description="机场情报（Airport Intelligence）收录 31 家机场品牌档案、154 条套餐价格、39 份历史测速证据、客户端兼容性与运营风险记录，帮助用户依据事实做出网络服务决策。"
>
  <!-- 第一屏：品牌 Hero -->
  <section class="border-b border-slate-200 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7 space-y-5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-slate-200 bg-slate-50 text-xs font-mono text-[#0b192c]">
            <span class="w-2 h-2 rounded-full bg-teal-600"></span>
            <span>AIRPORT INTELLIGENCE · JICHANGQINGBAO.BIZ</span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-[42px] font-bold text-[#0b192c] leading-[1.18] tracking-tight">
            机场情报 — 机场品牌档案、风险情报与专业评测
          </h1>

          <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl">
            从品牌运营、套餐价格、线路性能、客户端兼容性到风险情报，帮助用户了解不同网络服务之间的实际差异。
          </p>

          <form action="/search/" method="get" class="flex flex-col sm:flex-row gap-2.5 max-w-xl pt-1">
            <input
              type="search"
              name="q"
              placeholder="输入品牌名（如 光速云、唯兔云）、客户端或报错症状…"
              aria-label="全站搜索"
              class="flex-1 h-11 px-4 text-sm rounded-lg border border-slate-300 bg-slate-50 focus:bg-white focus:border-[#0b192c] focus:outline-none"
            />
            <button
              type="submit"
              class="h-11 px-6 rounded-lg bg-[#0b192c] text-white text-sm font-semibold hover:bg-[#13294b] transition-colors shrink-0"
            >
              全站情报检索
            </button>
          </form>

          <div class="flex flex-wrap items-center gap-3 pt-1">
            <a href="/brands/" class="px-4 py-2.5 rounded-lg bg-[#0b192c] text-white text-xs sm:text-sm font-semibold hover:bg-[#13294b] transition-colors">
              进入 31 品牌数据库
            </a>
            <a href="/recommend/" class="px-4 py-2.5 rounded-lg border border-slate-300 bg-white text-[#0b192c] text-xs sm:text-sm font-semibold hover:bg-slate-50 transition-colors">
              查看机场推荐
            </a>
            <a href="/intelligence/" class="px-4 py-2.5 rounded-lg border border-teal-300 bg-teal-50 text-teal-900 text-xs sm:text-sm font-semibold hover:bg-teal-100 transition-colors">
              查看风险情报中心
            </a>
            <a href="/brands/guangsuyun/" class="px-4 py-2.5 rounded-lg border border-sky-200 bg-sky-50 text-sky-900 text-xs sm:text-sm font-semibold hover:bg-sky-100 transition-colors">
              光速云旗舰评测
            </a>
          </div>
        </div>

        <!-- Dark Network Observatory Hero Telemetry Panel -->
        <div class="lg:col-span-5">
          <div class="observatory-panel rounded-2xl p-5 sm:p-6">
            <div class="flex items-center justify-between gap-2 pb-3 border-b border-slate-700/70">
              <span class="font-mono text-[11px] uppercase tracking-wider text-teal-300">Observatory Telemetry</span>
              <span class="font-mono text-[11px] text-slate-400">Updated {SITE_META.lastUpdated}</span>
            </div>

            <div class="mt-4 space-y-3">
              <div class="observatory-subpanel rounded-lg p-3.5 flex items-center justify-between">
                <div>
                  <span class="text-[11px] text-slate-400 block">品牌实体与冲突审计</span>
                  <strong class="text-sm text-white">严格区分实测与商家资料</strong>
                </div>
                <span class="font-mono text-xs px-2 py-1 rounded bg-teal-950 text-teal-300 border border-teal-700/60">
                  {brands.length} Entities
                </span>
              </div>

              <div class="observatory-subpanel rounded-lg p-3.5 flex items-center justify-between">
                <div>
                  <span class="text-[11px] text-slate-400 block">核心合作旗舰品牌</span>
                  <strong class="text-sm text-white">光速云 · 2020年运营 / 7档套餐</strong>
                </div>
                <a href="/brands/guangsuyun/" class="font-mono text-xs text-sky-300 hover:underline">
                  档案 →
                </a>
              </div>

              <div class="observatory-subpanel rounded-lg p-3.5 flex items-center justify-between">
                <div>
                  <span class="text-[11px] text-slate-400 block">历史实测截图批次</span>
                  <strong class="text-sm text-white">2026-07-18 / 08-11 / 08-19 原始图</strong>
                </div>
                <a href="/network/speedtest/" class="font-mono text-xs text-teal-300 hover:underline">
                  证据库 →
                </a>
              </div>
            </div>

            <p class="mt-4 pt-3 border-t border-slate-700/70 text-[11px] text-slate-400 leading-relaxed">
              所有测试数据均标明测试日期、工具环境与局限；无数据字段绝不填充虚假评分或模拟测试结果。
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 第二屏：情报数据概览 -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
      <div class="editorial-card rounded-xl p-4">
        <span class="text-xs text-slate-500 block">已收录独立品牌</span>
        <strong class="text-2xl font-mono font-bold text-[#0b192c] mt-1 block">{brands.length}</strong>
        <span class="text-[11px] text-teal-700">去重合并后实体</span>
      </div>
      <div class="editorial-card rounded-xl p-4">
        <span class="text-xs text-slate-500 block">结构化套餐记录</span>
        <strong class="text-2xl font-mono font-bold text-[#0b192c] mt-1 block">{plans.length}</strong>
        <span class="text-[11px] text-slate-500">含 {noExpiryPlansCount} 个不限时包</span>
      </div>
      <div class="editorial-card rounded-xl p-4">
        <span class="text-xs text-slate-500 block">历史测试记录</span>
        <strong class="text-2xl font-mono font-bold text-[#0b192c] mt-1 block">{testResults.length}</strong>
        <span class="text-[11px] text-slate-500">覆盖 {testedBrandsCount} 家品牌</span>
      </div>
      <div class="editorial-card rounded-xl p-4">
        <span class="text-xs text-slate-500 block">核心客户端档案</span>
        <strong class="text-2xl font-mono font-bold text-[#0b192c] mt-1 block">{clients.length}</strong>
        <span class="text-[11px] text-slate-500">覆盖 6 大操作系统</span>
      </div>
      <div class="editorial-card rounded-xl p-4">
        <span class="text-xs text-slate-500 block">字段冲突审计</span>
        <strong class="text-2xl font-mono font-bold text-amber-600 mt-1 block">{dataConflicts.length}</strong>
        <span class="text-[11px] text-slate-500">透明披露差异</span>
      </div>
      <div class="editorial-card rounded-xl p-4">
        <span class="text-xs text-slate-500 block">最近全站更新</span>
        <strong class="text-lg font-mono font-bold text-[#0b192c] mt-1.5 block">{SITE_META.lastUpdated}</strong>
        <span class="text-[11px] text-slate-500">基准 {SITE_META.verifiedSnapshotDate}</span>
      </div>
    </div>
  </section>

  <!-- 第三屏：最新机场情报动态 -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-6">
    <div class="flex flex-wrap items-end justify-between gap-3 mb-4">
      <div>
        <span class="font-mono text-xs uppercase tracking-wider text-teal-700 font-semibold">Intelligence Feed</span>
        <h2 class="text-xl sm:text-2xl font-bold text-[#0b192c] mt-0.5">最新机场情报动态与变更核实</h2>
      </div>
      <a href="/intelligence/" class="text-xs font-semibold text-[#0b192c] hover:underline">进入情报中心全部记录 →</a>
    </div>
    <TimelineList events={intelligenceEvents} limit={5} />
  </section>

  <!-- 第四屏：精选机场推荐（合作展示顺序） -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    <div class="flex flex-wrap items-end justify-between gap-3 mb-4">
      <div>
        <span class="font-mono text-xs uppercase tracking-wider text-sky-700 font-semibold">Featured Cooperation Showcase</span>
        <h2 class="text-xl sm:text-2xl font-bold text-[#0b192c] mt-0.5">精选合作机场展示（非客观实测排名）</h2>
        <p class="text-xs text-slate-500 mt-1">
          以下 11 个品牌按合作展示优先级排序，光速云为核心合作品牌；商业展示顺序独立于实测数据与风险评级。
        </p>
      </div>
      <a href="/recommend/" class="text-xs font-semibold text-[#0b192c] hover:underline">查看按需选型指南 →</a>
    </div>

    <!-- Core Flagship Highlight: Guangsuyun -->
    <div class="editorial-card rounded-2xl p-5 sm:p-6 mb-5 border-sky-200 bg-gradient-to-r from-sky-50/60 to-white">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-center">
        <div class="lg:col-span-8 space-y-2.5">
          <div class="flex items-center gap-3">
            <BrandLogo brand={lightspeed} size="lg" />
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="text-lg sm:text-xl font-bold text-[#0b192c]">光速云（LightSpeed）· 核心合作品牌旗舰档案</h3>
                <span class="px-2 py-0.5 rounded bg-sky-100 text-sky-900 font-mono text-[11px] font-semibold">2020年运营</span>
              </div>
              <p class="text-xs text-slate-500 mt-0.5">
                IEPL / IPLC 专线 · VLESS 协议 · 自研客户端 + Clash / Shadowrocket 第三方订阅导入 · 优惠码 AMM
              </p>
            </div>
          </div>
          <p class="text-sm text-slate-700 leading-relaxed">
            提供致敬斯诺克147永久套餐（147元/247GB）、轻量版年付（99元/年，折合8.25元/月，69GB/月）及极速版（25元/月，168GB/月）至定制版（680元/月）共 7 档套餐。本站收录其 2026-08-11 测速图与 2026-08-19 三网及 70 节点 MiaoKo 实测证据，同时明确提示 59GB/69GB 记录差异与特殊套餐不退款规则。
          </p>
        </div>
        <div class="lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-2.5">
          <a href="/brands/guangsuyun/" class="px-4 py-2.5 rounded-lg bg-[#0b192c] text-white text-xs sm:text-sm font-semibold text-center hover:bg-[#13294b]">
            阅读光速云旗舰深度评测 →
          </a>
          <a href="/pricing/guangsuyun-plans/" class="px-4 py-2 rounded-lg border border-slate-300 bg-white text-[#0b192c] text-xs font-semibold text-center hover:bg-slate-50">
            查看套餐选择与优惠码说明
          </a>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {featuredBrands.slice(1).map((b) => (
        <BrandCard brand={b} showPriorityBadge={true} />
      ))}
    </div>
  </section>

  <!-- 第五屏：机场品牌数据库总表 -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    <div class="flex flex-wrap items-end justify-between gap-3 mb-4">
      <div>
        <span class="font-mono text-xs uppercase tracking-wider text-teal-700 font-semibold">Brand Directory</span>
        <h2 class="text-xl sm:text-2xl font-bold text-[#0b192c] mt-0.5">机场品牌数据库（{allBrands.length} 家独立实体）</h2>
      </div>
      <a href="/brands/" class="text-xs font-semibold text-[#0b192c] hover:underline">打开多维度筛选器 →</a>
    </div>

    <div class="editorial-card rounded-xl overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200 text-slate-600">
              <th class="py-3 px-4 font-semibold">品牌名称</th>
              <th class="py-3 px-3 font-semibold">运营时间</th>
              <th class="py-3 px-3 font-semibold">入门价 / 周期</th>
              <th class="py-3 px-3 font-semibold">线路 / 协议</th>
              <th class="py-3 px-3 font-semibold">客户端模式</th>
              <th class="py-3 px-3 font-semibold">资料状态</th>
              <th class="py-3 px-4 font-semibold text-right">档案与评测</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {allBrands.map((b) => {
              const { cheapestMonthly, cheapestAnnual } = getEntryPlan(b);
              const st = getStatusBadgeStyle(b.dataStatus);
              return (
                <tr class="hover:bg-slate-50/70 transition-colors">
                  <td class="py-2.5 px-4 font-semibold text-[#0b192c]">
                    <a href={`/brands/${b.slug}/`} class="hover:underline">{b.brandName}</a>
                  </td>
                  <td class="py-2.5 px-3 font-mono text-slate-600">{b.foundedYear ? `${b.foundedYear}年` : '待核实'}</td>
                  <td class="py-2.5 px-3 font-mono text-[#0b192c]">
                    {cheapestAnnual
                      ? `¥${cheapestAnnual.monthlyEquivalent}/月(年付)`
                      : cheapestMonthly
                        ? `¥${cheapestMonthly.price}/月`
                        : '待核实'}
                  </td>
                  <td class="py-2.5 px-3 text-slate-600">{b.networkTypes[0]} · {b.protocols[0]}</td>
                  <td class="py-2.5 px-3 text-slate-600">
                    {b.thirdPartyClientSupport === false
                      ? '仅专属客户端'
                      : b.thirdPartyClientSupport === true
                        ? '支持第三方订阅'
                        : '待核实'}
                  </td>
                  <td class="py-2.5 px-3">
                    <span class={`inline-flex items-center gap-1 px-2 py-0.5 rounded border text-[10px] ${st.bg} ${st.text}`}>
                      <span class={`status-dot ${st.dot}`}></span>
                      {b.dataStatus}
                    </span>
                  </td>
                  <td class="py-2.5 px-4 text-right whitespace-nowrap">
                    <a href={`/brands/${b.slug}/`} class="text-teal-700 font-semibold hover:underline">档案评测 →</a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 第六屏：价格与套餐情报 -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    <div class="flex flex-wrap items-end justify-between gap-3 mb-4">
      <div>
        <span class="font-mono text-xs uppercase tracking-wider text-teal-700 font-semibold">Pricing Intelligence</span>
        <h2 class="text-xl sm:text-2xl font-bold text-[#0b192c] mt-0.5">价格与套餐专题情报</h2>
      </div>
      <a href="/pricing/" class="text-xs font-semibold text-[#0b192c] hover:underline">进入 {plans.length} 条套餐数据库 →</a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3.5">
      <a href="/pricing/cheap/" class="editorial-card rounded-xl p-4 block">
        <span class="font-mono text-xs text-teal-700 font-semibold">5.6–10 元/月</span>
        <h3 class="text-sm font-bold text-[#0b192c] mt-1">便宜与低预算机场</h3>
        <p class="text-xs text-slate-600 mt-1.5">拆解年付折算价与 5.6 元档 5 家品牌的实际限制。</p>
      </a>
      <a href="/pricing/monthly/" class="editorial-card rounded-xl p-4 block">
        <span class="font-mono text-xs text-teal-700 font-semibold">低试错周期</span>
        <h3 class="text-sm font-bold text-[#0b192c] mt-1">月付机场</h3>
        <p class="text-xs text-slate-600 mt-1.5">14.9–27 元主流月付门槛，适合先验证晚高峰再续费。</p>
      </a>
      <a href="/pricing/annual/" class="editorial-card rounded-xl p-4 block">
        <span class="font-mono text-xs text-teal-700 font-semibold">折算月成本</span>
        <h3 class="text-sm font-bold text-[#0b192c] mt-1">年付小包对比</h3>
        <p class="text-xs text-slate-600 mt-1.5">核查 79 元至 137 元年付小包流量上限与退款风险。</p>
      </a>
      <a href="/pricing/no-expiry/" class="editorial-card rounded-xl p-4 block">
        <span class="font-mono text-xs text-teal-700 font-semibold">{noExpiryPlansCount} 款一次性包</span>
        <h3 class="text-sm font-bold text-[#0b192c] mt-1">不限时流量机场</h3>
        <p class="text-xs text-slate-600 mt-1.5">对比光速云147元/247GB、二猫云99元/100GB等方案。</p>
      </a>
      <a href="/pricing/high-traffic/" class="editorial-card rounded-xl p-4 block">
        <span class="font-mono text-xs text-teal-700 font-semibold">500GB–2TB/月</span>
        <h3 class="text-sm font-bold text-[#0b192c] mt-1">大流量与定制档</h3>
        <p class="text-xs text-slate-600 mt-1.5">覆盖 500GB 至 2TB 重度流量与独享定制方案对比。</p>
      </a>
    </div>
  </section>

  <!-- 第七屏：网络性能与历史测试报告（Dark Observatory） -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    <div class="observatory-panel rounded-2xl p-6 sm:p-8">
      <div class="flex flex-wrap items-end justify-between gap-4 pb-5 border-b border-slate-700/70">
        <div>
          <span class="font-mono text-xs uppercase tracking-wider text-teal-300">Dark Network Observatory</span>
          <h2 class="text-xl sm:text-2xl font-bold text-white mt-1">网络性能证据库与 AI / 流媒体可用性矩阵</h2>
          <p class="text-xs sm:text-sm text-slate-300 mt-1.5 max-w-2xl">
            基于 2026-07-18/19、2026-08-11（MAI-TEST-BOT）及 2026-08-19（MiaoKo 三网及单线程）原始截图建立，明确标注测试环境、0B/KB 异常节点与非晚高峰前提。
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href="/network/speedtest/" class="px-4 py-2 rounded-lg bg-teal-600 text-white text-xs font-semibold hover:bg-teal-500">
            查看全部实测截图档案 →
          </a>
          <a href="/streaming-ai/" class="px-4 py-2 rounded-lg border border-slate-600 text-slate-200 text-xs font-semibold hover:bg-slate-800">
            AI 与流媒体矩阵
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-6">
        <div class="observatory-subpanel rounded-xl p-4">
          <span class="font-mono text-[11px] text-teal-300">BATCH 2026-08-11</span>
          <h3 class="text-sm font-bold text-white mt-1">15 家收录品牌单日测速截图</h3>
          <p class="text-xs text-slate-300 mt-1.5 leading-relaxed">
            涵盖光速云、飞猫云、星岛梦、二猫云、唯兔云、宇宙云、U1S1、灵猫、极连云、光年梯、一翻云、SOGO、可信云、速界、全球云。
          </p>
        </div>
        <div class="observatory-subpanel rounded-xl p-4">
          <span class="font-mono text-[11px] text-sky-300">BATCH 2026-08-19</span>
          <h3 class="text-sm font-bold text-white mt-1">光速云三网 + 70 节点解锁图</h3>
          <p class="text-xs text-slate-300 mt-1.5 leading-relaxed">
