---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import GeoAnswerBox from '../../components/seo/GeoAnswerBox.astro';
import AnchorToc from '../../components/seo/AnchorToc.astro';
import FaqSection from '../../components/seo/FaqSection.astro';
import { dataConflicts, formatSourceLabel, sources, SITE_META } from '../../lib/data';

const changelogFaqs = [
  { q: '为什么网站保留了多达 18 项“冲突数据”而不直接悄悄删改统一掉？', a: '因为保持不同历史来源文档可追溯，避免人为挑选其中较好看的数字掩盖另外一处限制（例如光速云 59GB vs 69GB 或微风 7 元 vs 137 元），是严肃网络情报平台的基石。' },
  { q: '冲突编号 `CF-002`（Firefly 实体去重）对网站数据总数有什么影响？', a: '原清单文件名“32家机场品牌清单”中把 Firefly 与 Firefly 萤火虫列在两处；去重合并后全站严谨确定为 31 家独立品牌实体，不为了凑整数而虚构第 32 家。' },
  { q: '云界线与环球梯在 `CF-013/CF-014` 提到的链接缺 `#/` 怎么对待？', a: '部分现代前后端分离面板必须有 `#/` 锚点引导路由，原文文本遗漏时本站按不臆测补造外链规范保留标注“格式待核实”，购买核查入口以官方发布渠道为准。' },
  { q: '出现冲突的优惠码应该听信哪一版？', a: '所有存在来源差异的优惠码均建议以目标品牌官方结账面板下单输入时实时显示抵扣金额为准。' },
  { q: '可信云 `CF-012` 测试日期推断代表什么？', a: '表示原始图片日期区域因遮挡无法单独辨识，通过同日整包（2026-08-11_V2）采集元数据完成对应，因此在站内统一标记待复核而非标成独立绝对日。' },
  { q: '如果品牌方最新修改了价格或澄清了某条冲突怎么通知更新？', a: '可通过页脚 /corrections/ 页面提交规范化的官方变动公告或核对证明以更新日志记录。' },
];

const tocItems = [
  { id: 'cl-conflicts', label: `跨来源冲突审计清单（${dataConflicts.length} 项）` },
  { id: 'cl-sources', label: `原始来源台账（${sources.length} 份）` },
  { id: 'cl-policy', label: '冲突仲裁与更新原则' },
  { id: 'faq-heading', label: '审计日志常见问题（6 问）' },
];

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: '情报核实、数据冲突审计与更新日志',
  url: `${SITE_META.url}/intelligence/changelog/`,
  description: `公开披露 ${dataConflicts.length} 项跨来源字段冲突、实体去重逻辑及 ${sources.length} 份原始来源文件台账。`,
  inLanguage: 'zh-CN',
  dateModified: SITE_META.lastUpdated,
};
---

<BaseLayout
  title="情报核实、数据冲突审计与更新日志 | 机场情报"
  description="公开披露机场情报在合并 32 条原始品牌记录与多批次测速图过程中发现的 18 项字段冲突、实体合并依据及原始来源文件清单。"
  updatedAt={SITE_META.lastUpdated}
  schemas={[collectionSchema]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    <Breadcrumbs items={[{ label: '风险与替代', href: '/intelligence/' }, { label: '情报核实与更新日志' }]} />

    <header class="pb-5 border-b border-slate-200">
      <span class="font-mono text-xs uppercase tracking-wider text-teal-700 font-semibold">Audit & Changelog</span>
      <h1 class="text-2xl sm:text-3xl font-bold text-[#0b192c] mt-1">情报核实、数据冲突审计与更新日志</h1>
    </header>

    <GeoAnswerBox
      answer={`本站严格依据 ${sources.length} 份原始资料文件建立数据底座。在对齐 31 家去重品牌、154 条套餐及 39 份测速证据时，我们共审计出 ${dataConflicts.length} 项字段级冲突、截图遮挡或格式异常（包括 Firefly 实体合并、光速云 59GB/69GB 冲突、可信云批次回溯日期、云界线/环球梯链接缺 #/ 等），全部在下方公开公示。`}
      verifiedAt={SITE_META.lastUpdated}
      source="sources.json、data-conflicts.json"
    />

    <div class="mt-6 grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <aside class="lg:col-span-4 lg:sticky lg:top-24">
        <AnchorToc title="冲突审计目录" items={tocItems} />
      </aside>

      <div class="lg:col-span-8 space-y-8 min-w-0">
        <section id="cl-conflicts" class="scroll-mt-24">
          <h2 class="text-xl font-bold text-[#0b192c] mb-4">一、跨来源字段冲突与实体审计清单（{dataConflicts.length} 项）</h2>
          <div class="space-y-3">
            {dataConflicts.map((cf) => (
              <article class="editorial-card rounded-xl p-4 sm:p-5">
                <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                  <div class="flex items-center gap-2">
                    <span class="font-mono text-xs font-bold px-2 py-0.5 rounded bg-[#0b192c] text-white">{cf.conflictId}</span>
                    {cf.brandId !== 'global' ? (
                      <a href={`/brands/${cf.brandId}/`} class="text-base font-bold text-[#0b192c] hover:underline">{cf.brandName}</a>
                    ) : (
                      <span class="text-base font-bold text-[#0b192c]">{cf.brandName}</span>
                    )}
                    <span class="text-xs text-slate-600">— {cf.field}</span>
                  </div>
                  <span class="font-mono text-xs px-2 py-0.5 rounded bg-amber-50 border border-amber-200 text-amber-800">
                    {cf.status} · {cf.detectedAt}
                  </span>
                </div>
                <ul class="list-disc pl-5 text-xs sm:text-sm text-slate-700 space-y-1">
                  {cf.values.map((v) => <li>{formatSourceLabel(v)}</li>)}
                </ul>
                <p class="mt-2.5 pt-2 border-t border-slate-100 text-xs sm:text-sm font-medium text-[#0b192c]">
                  处理结论：{formatSourceLabel(cf.resolution)}
                </p>
              </article>
            ))}
          </div>
        </section>

        <section id="cl-sources" class="scroll-mt-24">
          <h2 class="text-xl font-bold text-[#0b192c] mb-4">二、原始来源文件台账（{sources.length} 份）</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {sources.map((src) => (
              <div class="editorial-card rounded-xl p-4 text-xs">
                <div class="flex items-center justify-between gap-2 mb-1.5">
                  <strong class="text-sm text-[#0b192c]">{formatSourceLabel(src.title)}</strong>
                  <span class="font-mono px-2 py-0.5 rounded bg-slate-100 text-slate-700">{src.category}</span>
                </div>
                <p class="font-mono text-[11px] text-slate-500 mb-2">基准日期：{src.observedAt} · ID：{src.sourceId}</p>
                <p class="text-slate-700 leading-relaxed">{src.notes}</p>
              </div>
            ))}
          </div>
        </section>

        <section id="cl-policy" class="editorial-card rounded-xl p-5 sm:p-6 scroll-mt-24 space-y-2.5 text-sm text-slate-700 leading-relaxed">
          <h2 class="text-lg font-bold text-[#0b192c]">三、数据冲突处理四原则</h2>
          <p>面对跨文档冲突，本站绝不采用“静默二选一擦除记录”的方式处理，而是：1) 保留全部矛盾数值或描述版本供读者双线核查；2) 若涉及价格或流量额度不同，保守提醒以官方面板最终结算界面为准；3) 若涉及外链路由疑点（如缺 `#/`），直接标注待核实绝不私改跳转路径；4) 对仅存历史数据者独立打标等待新批次验证。</p>
        </section>

        <FaqSection title="核实日志常见问题（FAQ）" items={changelogFaqs} includeSchema={true} />
      </div>
    </div>
  </div>
</BaseLayout>
