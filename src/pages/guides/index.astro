---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import GeoAnswerBox from '../../components/seo/GeoAnswerBox.astro';
import AnchorToc from '../../components/seo/AnchorToc.astro';
import FaqSection from '../../components/seo/FaqSection.astro';
import BrandCard from '../../components/brands/BrandCard.astro';
import { getBrandBySlug, SITE_META } from '../../lib/data';
import { GUIDES_PILLAR_SECTIONS, GUIDES_PILLAR_FAQS } from '../../data/pillars/guides';

const sampleBrands = ['guangsuyun', 'tiziyun', 'feimao', 'weitu']
  .map((s) => getBrandBySlug(s))
  .filter((b): b is NonNullable<typeof b> => Boolean(b));

const subGuides = [
  { label: '机场订阅导入', href: '/guides/subscription/' },
  { label: 'Clash Verge Rev 配置', href: '/guides/clash-verge/' },
  { label: '全平台客户端安装', href: '/guides/installation/' },
  { label: '分流规则原理', href: '/guides/routing-rules/' },
  { label: 'TUN 模式详解', href: '/guides/tun-mode/' },
  { label: 'DNS 防泄漏配置', href: '/guides/dns/' },
  { label: '多设备协同规范', href: '/guides/multi-device/' },
  { label: '订阅安全管理', href: '/guides/subscription-management/' },
  { label: '套餐流量估算', href: '/guides/plan-selection/' },
  { label: '零基础入门指南', href: '/guides/beginner/' },
  { label: '光速云双模式教程', href: '/guides/guangsuyun-setup/' },
];

const osTutorialRoutes = [
  { os: 'Windows / macOS', client: 'Clash Verge Rev / FlClash', guide: 'Clash Verge Rev 配置教程', href: '/guides/clash-verge/' },
  { os: 'Android 手机', client: 'FlClash / v2rayNG', guide: '客户端安装与架构核对', href: '/guides/installation/' },
  { os: 'iPhone / iPad', client: 'Shadowrocket / Karing', guide: '机场订阅通用导入教程', href: '/guides/subscription/' },
  { os: 'AI 桌面端 / 命令行', client: '开启服务模式 + TUN', guide: 'TUN 模式安全配置指南', href: '/guides/tun-mode/' },
  { os: 'ChatGPT / Gemini 切区', client: '策略组指定日/新/美', guide: '分流规则与策略组教程', href: '/guides/routing-rules/' },
];

const tocItems = [
  { id: 'guide-phases', label: '四阶段新手配置路线图' },
  { id: 'guide-os-routes', label: '按系统与需求进入实操页' },
  ...GUIDES_PILLAR_SECTIONS.map((s) => ({ id: s.id, label: s.heading })),
  { id: 'guide-samples', label: '新手友好品牌参考档案' },
  { id: 'faq-heading', label: '使用教程常见问题（8 问）' },
];

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: '零基础配置代理客户端与机场订阅四步指南',
  description: '涵盖确认订阅兼容性、核对系统架构安装客户端、导入订阅启用规则分流及按需开启 TUN 模式。',
  step: [
    { '@type': 'HowToStep', position: 1, name: '选定兼容模式与套餐', url: `${SITE_META.url}/guides/plan-selection/` },
    { '@type': 'HowToStep', position: 2, name: '安装官方正版对应架构客户端', url: `${SITE_META.url}/guides/installation/` },
    { '@type': 'HowToStep', position: 3, name: '导入订阅链接并开启 Rule 分流', url: `${SITE_META.url}/guides/subscription/` },
    { '@type': 'HowToStep', position: 4, name: '按需开启 TUN 模式与远程 DNS', url: `${SITE_META.url}/guides/tun-mode/` },
  ],
};
---

<BaseLayout
  title="机场使用教程与新手配置中心（订阅/Clash/TUN/DNS/分流规则）| 机场情报"
  description="机场情报使用教程总览：系统串联机场订阅导入、Clash Verge Rev 配置、全平台安装、分流规则、TUN 模式、DNS 防泄漏与多设备管理。"
  updatedAt={SITE_META.lastUpdated}
  schemas={[howToSchema]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    <Breadcrumbs items={[{ label: '使用教程中心' }]} />

    <header class="pb-5 border-b border-slate-200">
      <span class="font-mono text-xs uppercase tracking-wider text-teal-700 font-semibold">Pillar 08 · Practical Guides</span>
      <h1 class="text-2xl sm:text-3xl font-bold text-[#0b192c] mt-1">机场使用教程与新手配置指南中心</h1>
      <p class="mt-2 text-sm text-slate-600 max-w-3xl leading-relaxed">
        不重复堆砌长篇术语。本中心先把从零配置拆为四个清晰阶段，再让你一键直达 11 篇单点实操指南。
      </p>
      <div class="mt-4 flex flex-wrap gap-2 text-xs">
        {subGuides.map((g) => (
          <a href={g.href} class="px-2.5 py-1 rounded bg-slate-100 hover:bg-slate-200 font-medium text-[#0b192c]">{g.label}</a>
        ))}
      </div>
    </header>

    <GeoAnswerBox
      answer="新手配置跨境网络代理的标准路径分为四步：1) 依据需求选定支持第三方订阅或自研端的新手友好套餐；2) 从官方 GitHub 或正规商店按芯片架构下载客户端；3) 粘贴订阅链接并启用规则分流（Rule）；4) 如有 AI 桌面端或命令行需求，开启服务模式下的 TUN 虚拟网卡。点击下方分步路线即可进入对应实操教程。"
      verifiedAt={SITE_META.lastUpdated}
      source="第三方代理客户端.txt、光速云品牌信息.txt"
    />

    <!-- 4-Phase Roadmap Cards -->
    <section id="guide-phases" class="mt-6 scroll-mt-24">
      <h2 class="text-lg font-bold text-[#0b192c] mb-3">一、四阶段新手上手路线图</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a href="/guides/beginner/" class="editorial-card rounded-xl p-4 hover:border-teal-600 transition-colors block">
          <span class="font-mono text-xs text-teal-700 font-bold">STEP 01 · 认知选型</span>
          <h3 class="text-sm font-bold text-[#0b192c] mt-1">新手入门与套餐流量估算</h3>
          <p class="text-xs text-slate-600 mt-1.5">先分清专属端与第三方订阅区别，按自身月均流量挑选首月最小套餐。</p>
        </a>
        <a href="/guides/installation/" class="editorial-card rounded-xl p-4 hover:border-teal-600 transition-colors block">
          <span class="font-mono text-xs text-teal-700 font-bold">STEP 02 · 软件安装</span>
          <h3 class="text-sm font-bold text-[#0b192c] mt-1">识别芯片架构下载正版软件</h3>
          <p class="text-xs text-slate-600 mt-1.5">区分 x86_64 与 arm64，核对官方开源仓库，避开山寨破解包与共享 ID 风险。</p>
        </a>
        <a href="/guides/subscription/" class="editorial-card rounded-xl p-4 hover:border-teal-600 transition-colors block">
          <span class="font-mono text-xs text-teal-700 font-bold">STEP 03 · 订阅接入</span>
          <h3 class="text-sm font-bold text-[#0b192c] mt-1">导入订阅并开启 Rule 分流</h3>
          <p class="text-xs text-slate-600 mt-1.5">校准系统时间后粘贴订阅 URL，保持国内直连、境外自动代理。</p>
        </a>
        <a href="/guides/routing-rules/" class="editorial-card rounded-xl p-4 hover:border-teal-600 transition-colors block">
          <span class="font-mono text-xs text-teal-700 font-bold">STEP 04 · 进阶调优</span>
          <h3 class="text-sm font-bold text-[#0b192c] mt-1">AI 分流、TUN 与防泄漏 DNS</h3>
          <p class="text-xs text-slate-600 mt-1.5">让 ChatGPT/Gemini 固定走日/新/美节点，桌面端和终端全面稳定接管。</p>
        </a>
      </div>
    </section>

    <!-- Route Table -->
    <section id="guide-os-routes" class="mt-8 scroll-mt-24">
      <div class="flex items-baseline justify-between gap-4 mb-3">
        <h2 class="text-lg font-bold text-[#0b192c]">二、按系统环境与任务直达单篇教程</h2>
        <span class="font-mono text-[11px] text-slate-400">QUICK DISPATCH</span>
      </div>
      <div class="editorial-card rounded-xl overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-xs">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-200 text-slate-700">
                <th class="py-3 px-4">系统或场景</th>
                <th class="py-3 px-3">常用方案 / 客户端</th>
                <th class="py-3 px-4">对应详细实操页面</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {osTutorialRoutes.map((r) => (
                <tr class="hover:bg-slate-50/70">
                  <td class="py-2.5 px-4 font-semibold text-[#0b192c] whitespace-nowrap">{r.os}</td>
                  <td class="py-2.5 px-3 text-slate-700">{r.client}</td>
                  <td class="py-2.5 px-4">
                    <a href={r.href} class="text-teal-700 font-semibold hover:underline">{r.guide} →</a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Deep Editorial Sections + Anchor TOC -->
    <div class="mt-10 grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <aside class="lg:col-span-4 lg:sticky lg:top-24 space-y-4">
        <AnchorToc title="配置教程逻辑目录" items={tocItems} />
        <div class="editorial-card rounded-xl p-4 sm:p-5 text-xs text-slate-600 space-y-2">
          <p class="font-bold text-[#0b192c] text-sm">配好后遇报错怎么办？</p>
          <p>若遇到导入超时、全部节点全红、TUN 冲突断网或 ChatGPT 弹区域报错，请直接转入故障排查中心。</p>
          <div class="pt-2 flex flex-wrap gap-2">
            <a href="/diagnostics/" class="px-2.5 py-1.5 rounded bg-[#0b192c] text-white font-medium">打开故障诊断中心</a>
            <a href="/guides/guangsuyun-setup/" class="px-2.5 py-1.5 rounded border border-slate-300 text-[#0b192c] font-medium">光速云上手指引</a>
          </div>
        </div>
      </aside>

      <div class="lg:col-span-8 space-y-6">
        {GUIDES_PILLAR_SECTIONS.map((sec) => (
          <section id={sec.id} class="editorial-card rounded-xl p-5 sm:p-6 scroll-mt-24">
            <h2 class="text-lg sm:text-xl font-bold text-[#0b192c]">{sec.heading}</h2>
            <p class="mt-2 text-sm font-medium text-teal-800 bg-teal-50/60 border-l-2 border-teal-600 pl-3 py-1.5 rounded-r">
              {sec.lead}
            </p>
            <div class="mt-3 space-y-2.5 text-sm text-slate-700 leading-relaxed">
              {(sec.paragraphs ?? []).map((p) => (
                <p>{p}</p>
              ))}
            </div>
            {sec.bullets && sec.bullets.length > 0 && (
              <ul class="mt-4 space-y-2 text-xs sm:text-sm text-slate-700 bg-slate-50 rounded-lg p-4 border border-slate-100">
                {sec.bullets.map((b) => (
                  <li class="flex items-start gap-2">
                    <span class="text-teal-700 font-bold shrink-0">•</span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}

        <section id="guide-samples" class="scroll-mt-24">
          <h2 class="text-lg font-bold text-[#0b192c] mb-3">双模式与零配置代表档案样本</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {sampleBrands.map((b) => (
              <BrandCard brand={b} />
            ))}
          </div>
        </section>

        <FaqSection title="机场配置教程常见问题（FAQ）" items={GUIDES_PILLAR_FAQS} includeSchema={true} />
      </div>
    </div>
  </div>
</BaseLayout>
