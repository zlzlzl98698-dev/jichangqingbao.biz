---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import BrandLogo from '../../components/brands/BrandLogo.astro';
import AffiliateCta from '../../components/brands/AffiliateCta.astro';
import GeoAnswerBox from '../../components/seo/GeoAnswerBox.astro';
import AnchorToc from '../../components/seo/AnchorToc.astro';
import FaqSection from '../../components/seo/FaqSection.astro';
import BrandCard from '../../components/brands/BrandCard.astro';
import InfrastructureServiceSnapshot from '../../components/charts/InfrastructureServiceSnapshot.astro';
import PerformanceMonitoringReport from '../../components/charts/PerformanceMonitoringReport.astro';
import ServiceAvailabilityMatrix from '../../components/charts/ServiceAvailabilityMatrix.astro';
import NetworkPathObservatory from '../../components/charts/NetworkPathObservatory.astro';
import TimelineList from '../../components/intelligence/TimelineList.astro';
import {
  brands,
  intelligenceEvents,
  dataConflicts,
  formatSourceLabel,
  getBrandBySlug,
  getEntryPlan,
  getStatusBadgeStyle,
  SITE_META,
} from '../../lib/data';
import { getBrandEditorial } from '../../data/brand-editorial';

export async function getStaticPaths() {
  return brands.map((b) => ({
    params: { slug: b.slug },
  }));
}

const { slug } = Astro.params;
const brand = getBrandBySlug(slug!);
if (!brand) {
  throw new Error(`Brand not found: ${slug}`);
}

const reviewEntries = await getCollection('reviews');
const mdReview = reviewEntries.find((r) => r.data.brandSlug === brand.slug);
const renderedMd = mdReview ? await render(mdReview) : null;
const MdContent = renderedMd?.Content;

const matchingArticles = (await getCollection('articles', (a) => !a.data.draft)).filter((a) =>
  a.data.relatedBrands.includes(brand.slug)
);

const brandTocItems = [
  { id: 'brand-plans', label: '全量套餐与单位流量成本表' },
  { id: 'brand-perf', label: '历史测速、解锁与网络路径' },
  { id: 'brand-client-compat', label: '客户端兼容与订阅链接状态' },
  ...(matchingArticles.length > 0 ? [{ id: 'brand-articles', label: `关联实操指南（${matchingArticles.length} 篇）` }] : []),
  { id: 'brand-timeline', label: '品牌情报时间线日志' },
  { id: 'faq-heading', label: `常见问题（${getBrandEditorial(brand).faqs.length} 问）` },
];

const editorial = getBrandEditorial(brand);
const { cheapestMonthly, cheapestAnnual, hasNoExpiry } = getEntryPlan(brand);
const brandEvents = intelligenceEvents.filter((e) => e.brandSlug === brand.slug);
const brandConflicts = dataConflicts.filter((c) => c.brandId === brand.slug);
const alternativeBrandObjs = brand.alternativeBrands
  .map((s) => getBrandBySlug(s))
  .filter((b): b is NonNullable<typeof b> => Boolean(b));

const stData = getStatusBadgeStyle(brand.dataStatus);
const stOp = getStatusBadgeStyle(brand.operatingStatus);

const pageTitle =
  brand.slug === 'guangsuyun'
    ? '光速云评测与档案（LightSpeed）：套餐与三网实测 | 机场情报'
    : `${brand.brandName}评测与档案：套餐、线路与风险核实 | 机场情报`;

const pageDesc = mdReview?.data.description ?? `${brand.brandName}（${brand.aliases.join(' / ')}）品牌档案：${brand.description}`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${brand.brandName} 完整品牌档案与深度评测`,
  description: pageDesc,
  inLanguage: 'zh-CN',
  datePublished: brand.verifiedAt,
  dateModified: brand.updatedAt,
  author: { '@type': 'Organization', name: SITE_META.name },
  publisher: { '@id': `${SITE_META.url}/#organization` },
  about: {
    '@type': 'Brand',
    name: brand.brandName,
    alternateName: brand.aliases,
  },
};
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  ogType="article"
  publishedAt={brand.verifiedAt}
  updatedAt={brand.updatedAt}
  schemas={[articleSchema]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    <Breadcrumbs items={[{ label: '机场品牌库', href: '/brands/' }, { label: brand.brandName }]} />

    <!-- Header Entity Identity Bar -->
    <header class="editorial-card rounded-2xl p-5 sm:p-6 mb-6">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-5">
        <div class="flex items-start gap-4">
          <BrandLogo brand={brand} size="lg" />
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h1 class="text-2xl sm:text-3xl font-bold text-[#0b192c]">
                {brand.brandName}（{brand.aliases[0] ?? brand.slug}）深度评测与品牌档案
              </h1>
              {brand.slug === 'guangsuyun' && (
                <span class="px-2 py-0.5 rounded bg-sky-100 text-sky-900 font-mono text-xs font-semibold">核心合作品牌</span>
              )}
            </div>
            <p class="text-xs sm:text-sm text-slate-600 mt-1.5">
              实体 ID：<code class="font-mono text-slate-800">{brand.brandId}</code> · 别名：{brand.aliases.join(' / ')} · 运营：{brand.foundedYear ? `${brand.foundedYear} 年` : '待核实'} · 视角：{editorial.positioningAngle}
            </p>
            <div class="flex flex-wrap items-center gap-2 mt-2.5 text-xs">
              <span class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded border font-medium ${stData.bg} ${stData.text}`}>
                <span class={`status-dot ${stData.dot}`}></span>
                数据状态：{brand.dataStatus}
              </span>
              <span class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded border font-medium ${stOp.bg} ${stOp.text}`}>
                <span class={`status-dot ${stOp.dot}`}></span>
                风险状态：{brand.operatingStatus}
              </span>
              <span class="font-mono text-[11px] text-slate-500">
                核实：{brand.verifiedAt} · 更新：{brand.updatedAt}
              </span>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 shrink-0 bg-slate-50 p-3 rounded-xl border border-slate-200 text-xs">
          <div>
            <span class="text-[10px] text-slate-500 block">年付折算起步</span>
            <strong class="font-mono text-[#0b192c] text-sm">
              {cheapestAnnual ? `¥${cheapestAnnual.monthlyEquivalent}/月` : '无/待核实'}
            </strong>
          </div>
          <div>
            <span class="text-[10px] text-slate-500 block">月付门槛</span>
            <strong class="font-mono text-[#0b192c] text-sm">
              {cheapestMonthly ? `¥${cheapestMonthly.price}/月` : '仅年付/待核实'}
            </strong>
          </div>
          <div>
            <span class="text-[10px] text-slate-500 block">不限时套餐</span>
            <strong class="font-mono text-[#0b192c] text-sm">{hasNoExpiry ? '有' : '未收录'}</strong>
          </div>
        </div>
      </div>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <article class="lg:col-span-8">
        <!-- 1. Answer-First Verdict -->
        <GeoAnswerBox
          label="1. 品牌核心结论与适用条件"
          answer={editorial.verdict}
          verifiedAt={brand.verifiedAt}
          source={brand.sources.join('、')}
        />

        <!-- Affiliate CTA -->
        <div class="my-5">
          <AffiliateCta brand={brand} variant="banner" />
        </div>

        <!-- 4 Dark Network Observatory Charts -->
        <InfrastructureServiceSnapshot brand={brand} />

        <!-- Field Conflict Audit Box (if any) -->
        {brandConflicts.length > 0 && (
          <section class="my-6 rounded-xl border border-amber-300 bg-amber-50/70 p-4 sm:p-5">
            <h2 class="text-base font-bold text-amber-950 mb-2">字段冲突与口径审计提示（{brandConflicts.length} 项）</h2>
            <div class="space-y-3 text-xs text-amber-950">
              {brandConflicts.map((cf) => (
                <div class="bg-white/80 rounded-lg p-3 border border-amber-200">
                  <p class="font-bold">[{cf.conflictId}] {cf.field}（状态：{cf.status}）</p>
                  <ul class="list-disc pl-4 mt-1 space-y-0.5">
                    {cf.values.map((v) => <li>{formatSourceLabel(v)}</li>)}
                  </ul>
                  <p class="mt-1.5 font-medium text-slate-800">处理口径：{formatSourceLabel(cf.resolution)}</p>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Full Markdown Dossier for Flagship Brands (e.g. 光速云) -->
        {MdContent && (
          <div class="prose-intel my-6">
            <MdContent />
          </div>
        )}

        <!-- Structured Pricing & Cost Per GB Table (Section 11 items 5-8) -->
        <section id="brand-plans" class="my-8 scroll-mt-24">
          <h2 class="text-xl font-bold text-[#0b192c] mb-3 pb-2 border-b border-slate-200">
            {MdContent ? '全量套餐与单位流量成本速查表' : '2. 全部已有套餐、年付折算与不限时流量成本'}
          </h2>
          <p class="text-xs text-slate-600 mb-3">
            以下价格与流量严格取自收录资料原文（核实基准：{brand.verifiedAt}），年付折算成本按 12 个月平均，不得将年付折算价理解为按月单付价格。
          </p>
          <div class="editorial-card rounded-xl overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full text-left border-collapse text-xs">
                <thead>
                  <tr class="bg-slate-50 border-b border-slate-200 text-slate-700">
                    <th class="py-2.5 px-3">套餐名称</th>
                    <th class="py-2.5 px-3">计费周期</th>
                    <th class="py-2.5 px-3">价格</th>
                    <th class="py-2.5 px-3">流量配额</th>
                    <th class="py-2.5 px-3">折算月成本</th>
                    <th class="py-2.5 px-3">单位流量单价</th>
                    <th class="py-2.5 px-3">备注</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {brand.plans.map((p) => {
                    const perGb = p.trafficGb ? (p.price / p.trafficGb).toFixed(2) : null;
                    return (
                      <tr>
                        <td class="py-2.5 px-3 font-semibold text-[#0b192c]">{p.planName}</td>
                        <td class="py-2.5 px-3">{p.billingCycle}</td>
                        <td class="py-2.5 px-3 font-mono font-semibold text-[#0b192c]">¥{p.price}</td>
                        <td class="py-2.5 px-3 font-mono">{p.trafficGb ? `${p.trafficGb} GB` : '待核实'}（{p.trafficReset}）</td>
                        <td class="py-2.5 px-3 font-mono">{p.monthlyEquivalent ? `¥${p.monthlyEquivalent}/月` : '—'}</td>
                        <td class="py-2.5 px-3 font-mono">{perGb ? `¥${perGb}/GB` : '—'}</td>
                        <td class="py-2.5 px-3 text-slate-500">{p.notes || '—'}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- Performance & Availability & Topology Charts -->
        <div id="brand-perf" class="scroll-mt-24">
          <PerformanceMonitoringReport brand={brand} />
          <ServiceAvailabilityMatrix brand={brand} />
          <NetworkPathObservatory brand={brand} />
        </div>

        <!-- Tailored Structured Analysis (for brands without full MD, or complementary summary) -->
        {!MdContent && (
          <div class="prose-intel space-y-6 my-8">
            <section>
              <h2>3. 品牌背景、运营时间与资料可信度</h2>
              <p>{brand.description}</p>
              <p><strong>状态依据：</strong>{brand.statusEvidence}</p>
              <p><strong>官网与入口辨识：</strong>{brand.officialWebsite}。推广优惠码：<code class="font-mono">{brand.couponCode}</code>（{brand.couponRestrictions}）。</p>
            </section>

            <section>
              <h2>4. 网络线路、协议、节点与设备限制</h2>
              <ul>
                <li><strong>线路类型：</strong>{brand.networkTypes.join(' / ')}</li>
                <li><strong>记录协议：</strong>{brand.protocols.join(' / ')}</li>
                <li><strong>节点地区：</strong>{brand.regions.join('、')}（节点数量：{brand.nodeCount}）</li>
                <li><strong>倍率与限速：</strong>流量倍率 {brand.trafficMultiplier}；速度限制 {brand.speedLimit}；设备限制 {brand.deviceLimit}。</li>
              </ul>
            </section>

            <section>
              <h2>5. 客户端兼容性、支付与退款规则</h2>
              <p>
                {brand.thirdPartyClientSupport === true
                  ? `支持第三方通用客户端订阅导入，兼容：${brand.compatibleClients.join('、')}。`
                  : brand.thirdPartyClientSupport === false
                    ? '仅支持品牌方提供的官方专属客户端登录使用，不提供 Clash、Shadowrocket 等第三方订阅链接。'
                    : '客户端兼容性当前处于待核实状态，不作第三方订阅可用性假设。'}
              </p>
              <p><strong>支付方式：</strong>{brand.paymentMethods.join(' / ')}。<strong>退款政策：</strong>{brand.refundPolicy}</p>
            </section>

            <section>
              <h2>6. 品牌优势、限制及适用人群判断</h2>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 not-prose my-3">
                <div class="editorial-card rounded-xl p-4">
                  <h3 class="text-sm font-bold text-teal-800 mb-2">资料体现的优势</h3>
                  <ul class="list-disc pl-4 text-xs text-slate-700 space-y-1.5">
                    {editorial.advantages.map((a) => <li>{a}</li>)}
                  </ul>
                </div>
                <div class="editorial-card rounded-xl p-4">
                  <h3 class="text-sm font-bold text-amber-800 mb-2">限制与数据缺口</h3>
                  <ul class="list-disc pl-4 text-xs text-slate-700 space-y-1.5">
                    {editorial.limitations.map((l) => <li>{l}</li>)}
                  </ul>
                </div>
                <div class="editorial-card rounded-xl p-4">
                  <h3 class="text-sm font-bold text-[#0b192c] mb-2">相对适合人群</h3>
                  <ul class="list-disc pl-4 text-xs text-slate-700 space-y-1.5">
                    {editorial.suitableFor.map((s) => <li>{s}</li>)}
                  </ul>
                </div>
                <div class="editorial-card rounded-xl p-4">
                  <h3 class="text-sm font-bold text-red-800 mb-2">不适合或需谨慎人群</h3>
                  <ul class="list-disc pl-4 text-xs text-slate-700 space-y-1.5">
                    {editorial.unsuitableFor.map((u) => <li>{u}</li>)}
                  </ul>
                </div>
              </div>
            </section>

            <section>
              <h2>7. 同类品牌横向差异与风险提示</h2>
              <p>{editorial.peerComparisonNote}</p>
              <ul>
                {editorial.riskAndBuyingNotes.map((r) => <li>{r}</li>)}
              </ul>
            </section>
          </div>
        )}

        <!-- Client Compatibility Badge Strip -->
        <section id="brand-client-compat" class="my-8 editorial-card rounded-xl p-5 scroll-mt-24">
          <h2 class="text-base font-bold text-[#0b192c] mb-2">客户端兼容清单与订阅链接状态</h2>
          {brand.thirdPartyClientSupport === true ? (
            <div class="flex flex-wrap gap-2 mt-2">
              {brand.compatibleClients.map((c) => (
                <span class="px-2.5 py-1 rounded bg-slate-100 border border-slate-200 text-xs font-medium text-[#0b192c]">{c}</span>
              ))}
              {brand.officialClient && (
                <span class="px-2.5 py-1 rounded bg-teal-50 border border-teal-200 text-xs font-medium text-teal-800">含官方自研客户端</span>
              )}
            </div>
          ) : brand.thirdPartyClientSupport === false ? (
            <p class="text-xs text-amber-800 bg-amber-50 border border-amber-200 rounded-lg p-3">
              注意：{brand.brandName} 仅支持官方专属客户端，不开放订阅链接，请勿按 Clash / Shadowrocket 通用导入教程操作。
            </p>
          ) : (
            <p class="text-xs text-slate-600">当前第三方客户端兼容能力标注为“待核实”。</p>
          )}
        </section>

        <!-- Linked Level-3 Articles -->
        {matchingArticles.length > 0 && (
          <section id="brand-articles" class="my-8 editorial-card rounded-xl p-5 scroll-mt-24">
            <div class="flex items-center justify-between gap-2 mb-3">
              <h2 class="text-lg font-bold text-[#0b192c]">{brand.brandName} 相关选型与实操长尾指南（{matchingArticles.length} 篇）</h2>
              <a href="/articles/" class="text-xs font-semibold text-teal-700 hover:underline">全部指南 →</a>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
              {matchingArticles.map((art) => (
                <a href={`/articles/${art.id}/`} class="rounded-lg border border-slate-200 bg-slate-50/70 p-3.5 hover:border-teal-600 block">
                  <span class="font-mono text-[10px] text-teal-700 block">{art.data.parentTopicLabel}</span>
                  <strong class="text-sm text-[#0b192c] mt-0.5 block">{art.data.h1}</strong>
                  <span class="text-slate-600 mt-1 block line-clamp-2">{art.data.description}</span>
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- Brand Intelligence Timeline -->
        <section id="brand-timeline" class="my-8 scroll-mt-24">
          <h2 class="text-xl font-bold text-[#0b192c] mb-3">品牌情报时间线与记录日志</h2>
          <TimelineList events={brandEvents} />
        </section>

        <!-- Alternative Brands -->
        {alternativeBrandObjs.length > 0 && (
          <section class="my-8">
            <div class="flex items-center justify-between mb-3">
              <h2 class="text-xl font-bold text-[#0b192c]">{brand.brandName} 同价位/同定位替代方案</h2>
              <a href="/intelligence/alternatives/" class="text-xs font-semibold text-teal-700 hover:underline">全部替代矩阵 →</a>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {alternativeBrandObjs.map((alt) => (
                <BrandCard brand={alt} />
              ))}
            </div>
          </section>
        )}

        <!-- Brand FAQ -->
        <FaqSection title={`${brand.brandName} 常见问题（GEO 长尾问答）`} items={editorial.faqs} />

        <!-- Bottom CTA -->
        <div class="my-6">
          <AffiliateCta brand={brand} variant="card" />
        </div>

        <!-- Sources & Verification Footer -->
        <footer class="rounded-xl border border-slate-200 bg-slate-50 p-4 text-xs text-slate-600 space-y-1">
          <p><strong>原始资料来源：</strong>{brand.sources.map((s) => formatSourceLabel(s)).join('、')}</p>
          <p><strong>资料核实日期：</strong>{brand.verifiedAt} · <strong>档案更新：</strong>{brand.updatedAt} · <a href="/corrections/" class="underline text-[#0b192c]">纠错反馈</a></p>
        </footer>
      </article>

      <!-- Sidebar -->
      <aside class="lg:col-span-4 space-y-5 lg:sticky lg:top-24">
        <AnchorToc title={`${brand.brandName} 档案目录`} items={brandTocItems} />

        <div class="editorial-card rounded-xl p-4 sm:p-5 space-y-3 text-xs">
          <h2 class="text-sm font-bold text-[#0b192c] pb-2 border-b border-slate-100">品牌事实摘要卡</h2>
          <dl class="space-y-2">
            <div class="flex justify-between gap-2"><dt class="text-slate-500">运营年份</dt><dd class="font-mono font-semibold">{brand.foundedYear ?? '待核实'}</dd></div>
            <div class="flex justify-between gap-2"><dt class="text-slate-500">协议记录</dt><dd class="font-mono text-right">{brand.protocols.join(' / ')}</dd></div>
            <div class="flex justify-between gap-2"><dt class="text-slate-500">推广优惠码</dt><dd class="font-mono font-bold text-[#0b192c]">{brand.couponCode}</dd></div>
            <div class="flex justify-between gap-2"><dt class="text-slate-500">设备限制</dt><dd class="text-right">{brand.deviceLimit}</dd></div>
            <div class="flex justify-between gap-2"><dt class="text-slate-500">实测图数量</dt><dd class="font-mono">{brand.testImages.length} 张</dd></div>
          </dl>
        </div>

        {brand.slug === 'guangsuyun' && (
          <div class="editorial-card rounded-xl p-4 sm:p-5 border-sky-200 bg-sky-50/40">
            <h2 class="text-sm font-bold text-[#0b192c] pb-2 border-b border-sky-100">光速云旗舰专题集群</h2>
            <ul class="mt-3 space-y-2 text-xs">
              <li><a href="/pricing/guangsuyun-plans/" class="font-semibold text-sky-900 hover:underline">套餐选择、优惠码与不限时分析 →</a></li>
              <li><a href="/guides/guangsuyun-setup/" class="font-semibold text-sky-900 hover:underline">光速云自研与第三方客户端教程 →</a></li>
              <li><a href="/network/guangsuyun-analysis/" class="font-semibold text-sky-900 hover:underline">光速云线路技术与三网测速分析 →</a></li>
              <li><a href="/intelligence/guangsuyun-risk/" class="font-semibold text-sky-900 hover:underline">光速云风险、退款政策与避坑说明 →</a></li>
            </ul>
          </div>
        )}

        <div class="editorial-card rounded-xl p-4 sm:p-5">
          <h2 class="text-sm font-bold text-[#0b192c] pb-2 border-b border-slate-100">延伸阅读与工具</h2>
          <ul class="mt-3 space-y-2 text-xs">
            <li><a href="/brands/compare/" class="text-[#0b192c] font-semibold hover:underline">进入品牌横向对比中心 →</a></li>
            <li><a href="/clients/" class="text-[#0b192c] font-semibold hover:underline">第三方客户端兼容性百科 →</a></li>
