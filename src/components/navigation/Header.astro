---
import { Image } from 'astro:assets';
import brandAvatar from '../../assets/brand-avatar.webp';
import { PRIMARY_NAV } from '../../data/navigation';
import { brands, plans, testResults, clients, SITE_META } from '../../lib/data';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur-sm">
  <!-- Top Intelligence Telemetry Strip -->
  <div class="bg-[#0b192c] text-slate-300 text-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-1.5 flex flex-wrap items-center justify-between gap-2">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-[11px]">
        <span class="inline-flex items-center gap-1.5 text-teal-300">
          <span class="w-1.5 h-1.5 rounded-full bg-teal-400"></span>
          NODE INTEL ACTIVE
        </span>
        <span>收录品牌: <strong class="text-white">{brands.length}</strong></span>
        <span class="hidden sm:inline">套餐记录: <strong class="text-white">{plans.length}</strong></span>
        <span class="hidden md:inline">测速证据: <strong class="text-white">{testResults.length}</strong></span>
        <span class="hidden lg:inline">客户端核心档案: <strong class="text-white">{clients.length}</strong></span>
        <span class="text-slate-400">资料基准: {SITE_META.verifiedSnapshotDate} / 更新: {SITE_META.lastUpdated}</span>
      </div>
      <div class="flex items-center gap-3 text-[11px]">
        <a href="/intelligence/changelog/" class="hover:text-white transition-colors">核实日志</a>
        <span class="text-slate-600">|</span>
        <a href="/disclosure/" class="hover:text-white transition-colors">推广披露</a>
        <span class="text-slate-600">|</span>
        <a href="/search/" class="text-teal-300 hover:text-teal-200 font-medium">全站检索</a>
      </div>
    </div>
  </div>

  <!-- Brand Bar & Search -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-14 gap-4">
      <a href="/" class="flex items-center gap-2.5 shrink-0 group">
        <Image
          src={brandAvatar}
          alt="机场情报品牌头像"
          width={64}
          height={64}
          class="w-9 h-9 rounded-lg border border-slate-200 bg-white object-cover shadow-xs group-hover:border-[#0b192c] transition-colors"
          loading="eager"
        />
        <div>
          <span class="block text-base font-bold text-[#0b192c] leading-tight">机场情报</span>
          <span class="block text-[10px] font-mono uppercase tracking-wider text-slate-500 leading-none">Airport Intelligence</span>
        </div>
      </a>

      <!-- Quick Desktop Search & Core Shortcuts -->
      <div class="hidden md:flex items-center gap-3 flex-1 max-w-md">
        <form action="/search/" method="get" class="relative w-full">
          <input
            type="search"
            name="q"
            placeholder="检索品牌、套餐价格、错误代码或客户端…"
            aria-label="全站检索"
            class="w-full h-9 pl-3 pr-16 text-xs rounded border border-slate-300 bg-slate-50 text-slate-900 placeholder:text-slate-400 focus:outline-none focus:border-[#0b192c] focus:bg-white"
          />
          <button
            type="submit"
            class="absolute right-1 top-1 h-7 px-2.5 text-[11px] font-medium rounded bg-[#0b192c] text-white hover:bg-[#13294b] transition-colors"
          >
            搜索
          </button>
        </form>
      </div>

      <div class="hidden lg:flex items-center gap-2 text-xs">
        <a href="/brands/guangsuyun/" class="px-2.5 py-1.5 rounded border border-sky-200 bg-sky-50 text-sky-900 font-medium hover:bg-sky-100 transition-colors">
          光速云旗舰档案
        </a>
        <a href="/brands/" class="px-2.5 py-1.5 rounded border border-slate-200 text-slate-700 hover:bg-slate-50 transition-colors">
          31 品牌库
        </a>
        <a href="/intelligence/" class="px-2.5 py-1.5 rounded bg-[#0b192c] text-white font-medium hover:bg-[#13294b] transition-colors">
          风险情报
        </a>
      </div>

      <!-- Mobile Menu Toggle -->
      <button
        id="mobile-menu-toggle"
        type="button"
        aria-label="展开导航菜单"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        class="lg:hidden inline-flex items-center gap-1.5 px-3 py-1.5 rounded border border-slate-300 text-xs font-medium text-[#0b192c] hover:bg-slate-50"
      >
        <span>导航目录</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- 10 Primary Navigation Bar (Desktop) -->
    <nav aria-label="主导航" class="hidden lg:block border-t border-slate-100">
      <ul class="flex items-center justify-between gap-1 -mb-px">
        {PRIMARY_NAV.map((cat) => {
          const isActive = currentPath === cat.href || currentPath.startsWith(cat.href);
          return (
            <li class="relative group nav-item-dropdown">
              <a
                href={cat.href}
                class={`inline-flex items-center gap-1 px-2.5 py-2.5 text-[13px] font-medium border-b-2 transition-colors whitespace-nowrap ${
                  isActive
                    ? 'border-[#0b192c] text-[#0b192c]'
                    : 'border-transparent text-slate-600 hover:text-[#0b192c] hover:border-slate-300'
                }`}
              >
                <span>{cat.label}</span>
                {cat.badge && (
                  <span class="px-1 py-0.5 text-[9px] font-mono rounded bg-teal-50 text-teal-700 border border-teal-200">
                    情报
                  </span>
                )}
                <svg class="w-3 h-3 text-slate-400 group-hover:text-[#0b192c]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </a>

              <!-- Multi-column Mega Dropdown -->
              <div class="nav-dropdown-panel hidden group-hover:block group-focus-within:block absolute left-0 top-full pt-1 z-50 w-[420px] max-w-[90vw]">
                <div class="rounded-lg border border-slate-200 bg-white shadow-xl p-4">
                  <div class="pb-2.5 mb-2.5 border-b border-slate-100 flex items-start justify-between gap-2">
                    <div>
                      <a href={cat.href} class="text-sm font-bold text-[#0b192c] hover:underline">
                        {cat.label}专题首页 →
                      </a>
                      <p class="text-[11px] text-slate-500 mt-0.5 leading-snug">{cat.summary}</p>
                    </div>
                  </div>
                  <div class="grid grid-cols-2 gap-x-3 gap-y-1">
                    {cat.items.map((item) => (
                      <a
                        href={item.href}
                        class={`px-2 py-1.5 rounded text-xs transition-colors ${
                          currentPath === item.href
                            ? 'bg-slate-100 text-[#0b192c] font-semibold'
                            : 'text-slate-700 hover:bg-slate-50 hover:text-[#0b192c]'
                        }`}
                      >
                        {item.label}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobile-nav-drawer" class="hidden lg:hidden border-t border-slate-200 bg-white max-h-[82vh] overflow-y-auto">
    <div class="p-4 space-y-3">
      <form action="/search/" method="get" class="flex gap-2">
        <input
          type="search"
          name="q"
          placeholder="搜索品牌、套餐或教程…"
          class="flex-1 h-9 px-3 text-sm rounded border border-slate-300 bg-slate-50"
        />
        <button type="submit" class="px-3 h-9 rounded bg-[#0b192c] text-white text-xs font-medium">
          检索
        </button>
      </form>

      <div class="divide-y divide-slate-100">
        {PRIMARY_NAV.map((cat) => (
          <details class="py-2 group">
            <summary class="flex items-center justify-between cursor-pointer text-sm font-semibold text-[#0b192c] list-none py-1">
              <span>{cat.label}</span>
              <span class="text-xs text-slate-400 font-normal">{cat.items.length} 专题</span>
            </summary>
            <div class="mt-2 pl-2 grid grid-cols-2 gap-1.5 pb-1">
              <a href={cat.href} class="col-span-2 text-xs font-semibold text-teal-700 py-1">
                进入 {cat.label} 专题首页 →
              </a>
              {cat.items.map((item) => (
                <a href={item.href} class="text-xs text-slate-600 hover:text-[#0b192c] py-1">
                  {item.label}
                </a>
              ))}
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-nav-drawer');
  if (toggleBtn && drawer) {
    toggleBtn.addEventListener('click', () => {
      const isHidden = drawer.classList.contains('hidden');
      drawer.classList.toggle('hidden');
      toggleBtn.setAttribute('aria-expanded', String(isHidden));
    });
  }
  // Prevent mega menu overflow on right-most nav items
  document.querySelectorAll('.nav-item-dropdown').forEach((li, index, all) => {
    if (index >= all.length - 3) {
      const panel = li.querySelector('.nav-dropdown-panel');
      if (panel) {
        panel.classList.remove('left-0');
        panel.classList.add('right-0');
      }
    }
  });
</script>
