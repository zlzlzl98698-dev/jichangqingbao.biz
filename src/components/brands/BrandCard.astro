---
import BrandLogo from './BrandLogo.astro';
import { getEntryPlan, getStatusBadgeStyle, type Brand } from '../../lib/data';

export interface Props {
  brand: Brand;
  showPriorityBadge?: boolean;
}

const { brand, showPriorityBadge = false } = Astro.props;
const { cheapestMonthly, cheapestAnnual, hasNoExpiry } = getEntryPlan(brand);
const statusStyle = getStatusBadgeStyle(brand.dataStatus);
const opStyle = getStatusBadgeStyle(brand.operatingStatus);
---

<article class="editorial-card rounded-xl p-4 sm:p-5 flex flex-col justify-between gap-4">
  <div>
    <div class="flex items-start justify-between gap-3">
      <div class="flex items-center gap-3 min-w-0">
        <BrandLogo brand={brand} size="md" />
        <div class="min-w-0">
          <div class="flex items-center gap-2 flex-wrap">
            <h3 class="text-base font-bold text-[#0b192c] truncate">
              <a href={`/brands/${brand.slug}/`} class="hover:underline">{brand.brandName}</a>
            </h3>
            {brand.slug === 'guangsuyun' && (
              <span class="px-1.5 py-0.5 rounded bg-sky-100 text-sky-900 font-mono text-[10px] font-semibold">
                核心合作品牌
              </span>
            )}
            {showPriorityBadge && brand.promotionPriority <= 11 && brand.slug !== 'guangsuyun' && (
              <span class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 font-mono text-[10px]">
                合作展示 #{brand.promotionPriority}
              </span>
            )}
          </div>
          <p class="text-[11px] text-slate-500 truncate mt-0.5">
            {brand.foundedYear ? `${brand.foundedYear}年运营` : '年份待核实'} · {brand.aliases.slice(0, 2).join(' / ') || brand.slug}
          </p>
        </div>
      </div>

      <span class={`inline-flex items-center gap-1 px-2 py-0.5 rounded border text-[10px] font-medium shrink-0 ${statusStyle.bg} ${statusStyle.text}`}>
        <span class={`status-dot ${statusStyle.dot}`}></span>
        {brand.dataStatus}
      </span>
    </div>

    <p class="mt-3 text-xs text-slate-600 leading-relaxed line-clamp-2">{brand.description}</p>

    <div class="mt-3.5 grid grid-cols-2 gap-2 text-xs bg-slate-50 rounded-lg p-2.5 border border-slate-100">
      <div>
        <span class="block text-[10px] text-slate-400">入门参考价</span>
        <strong class="font-mono text-[#0b192c]">
          {cheapestAnnual
            ? `¥${cheapestAnnual.monthlyEquivalent}/月起(年付)`
            : cheapestMonthly
              ? `¥${cheapestMonthly.price}/月起`
              : '待核实'}
        </strong>
      </div>
      <div>
        <span class="block text-[10px] text-slate-400">常规月付门槛</span>
        <strong class="font-mono text-[#0b192c]">
          {cheapestMonthly ? `¥${cheapestMonthly.price} / ${cheapestMonthly.trafficGb ?? '?'}GB` : '仅年付/待核实'}
        </strong>
      </div>
      <div>
        <span class="block text-[10px] text-slate-400">线路与协议</span>
        <span class="font-medium text-slate-700 truncate block">{brand.networkTypes[0]} · {brand.protocols[0]}</span>
      </div>
      <div>
        <span class="block text-[10px] text-slate-400">客户端模式</span>
        <span class="font-medium text-slate-700">
          {brand.thirdPartyClientSupport === false
            ? '仅专属客户端'
            : brand.thirdPartyClientSupport === true
              ? '支持第三方订阅'
              : '待核实'}
        </span>
      </div>
    </div>
  </div>

  <div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-2">
    <div class="flex items-center gap-1.5 flex-wrap">
      <span class={`inline-flex items-center gap-1 px-1.5 py-0.5 rounded border text-[10px] ${opStyle.bg} ${opStyle.text}`}>
        {brand.operatingStatus}
      </span>
      {hasNoExpiry && (
        <span class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 text-[10px]">含不限时包</span>
      )}
      {brand.testImages.length > 0 && (
        <span class="px-1.5 py-0.5 rounded bg-teal-50 text-teal-800 border border-teal-200 text-[10px]">含实测截图</span>
      )}
    </div>

    <a
      href={`/brands/${brand.slug}/`}
      class="text-xs font-semibold text-[#0b192c] hover:text-teal-700 whitespace-nowrap"
    >
      档案与评测 →
    </a>
  </div>
</article>
