---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  items: FaqItem[];
  includeSchema?: boolean;
}

const { title = '常见问题与核查说明（FAQ）', items, includeSchema = true } = Astro.props;

const faqSchema =
  includeSchema && items.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: items.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: {
            '@type': 'Answer',
            text: item.a,
          },
        })),
      }
    : null;
---

{items.length > 0 && (
  <section class="my-8 rounded-xl border border-slate-200 bg-white p-5 sm:p-6">
    <h2 class="text-lg sm:text-xl font-bold text-[#0b192c] pb-3 border-b border-slate-100">{title}</h2>
    <div class="divide-y divide-slate-100 mt-2">
      {items.map((item) => (
        <details class="py-3.5 group" open>
          <summary class="cursor-pointer font-semibold text-sm sm:text-base text-[#0b192c] list-none flex items-start justify-between gap-3">
            <span>{item.q}</span>
            <span class="text-slate-400 font-mono text-xs shrink-0 mt-0.5">+</span>
          </summary>
          <p class="mt-2 text-sm text-slate-700 leading-relaxed">{item.a}</p>
        </details>
      ))}
    </div>
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </section>
)}
