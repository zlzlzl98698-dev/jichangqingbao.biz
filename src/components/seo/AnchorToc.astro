---
export interface TocItem {
  id: string;
  label: string;
}

export interface Props {
  title?: string;
  items: TocItem[];
}

const { title = '本页专题目录', items } = Astro.props;
---

{items.length > 0 && (
  <nav aria-label={title} class="editorial-card rounded-xl p-4 sm:p-5">
    <div class="flex items-center justify-between pb-2 border-b border-slate-100">
      <h2 class="text-sm font-bold text-[#0b192c]">{title}</h2>
      <span class="font-mono text-[10px] text-slate-400">{items.length} SECTIONS</span>
    </div>
    <ol class="mt-3 space-y-1.5 text-xs text-slate-700 max-h-[60vh] overflow-y-auto pr-1">
      {items.map((item, idx) => (
        <li>
          <a
            href={`#${item.id}`}
            class="flex items-start gap-1.5 py-0.5 hover:text-[#0b192c] hover:underline transition-colors leading-snug"
          >
            <span class="font-mono text-[10px] text-slate-400 mt-0.5 shrink-0">{String(idx + 1).padStart(2, '0')}</span>
            <span>{item.label}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}
