---
import type { Brand } from '../../lib/data';

export interface Props {
  brand: Brand;
}

const { brand } = Astro.props;

function badgeFor(val: string) {
  if (val.startsWith('支持')) return { label: 'Supported', cls: 'bg-teal-950/70 text-teal-300 border-teal-700/60', dot: 'bg-teal-400' };
  if (val.startsWith('部分支持') || val.startsWith('品牌方宣称')) return { label: val.startsWith('品牌方宣称') ? 'Vendor Claimed' : 'Partial', cls: 'bg-amber-950/60 text-amber-300 border-amber-700/50', dot: 'bg-amber-400' };
  if (val.startsWith('不支持')) return { label: 'Unavailable', cls: 'bg-red-950/60 text-red-300 border-red-700/50', dot: 'bg-red-400' };
  if (val.startsWith('待核实')) return { label: 'Pending Verification', cls: 'bg-slate-800 text-amber-200 border-slate-600', dot: 'bg-amber-400' };
  return { label: 'Not Tested', cls: 'bg-slate-800/80 text-slate-400 border-slate-700', dot: 'bg-slate-500' };
}

const aiItems = Object.entries(brand.aiAvailability);
const streamItems = Object.entries(brand.streamingAvailability);
---

<section class="observatory-panel rounded-xl p-5 sm:p-6 my-6" aria-label={`${brand.brandName} Service Availability Matrix`}>
  <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-slate-700/70">
    <div>
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full" style={`background-color: ${brand.accentColor};`}></span>
        <span class="font-mono text-[11px] uppercase tracking-wider text-slate-400">Service Availability Matrix</span>
      </div>
      <h3 class="text-base sm:text-lg font-bold text-white mt-1">{brand.brandName} · AI 与流媒体可用性状态矩阵</h3>
    </div>
    <span class="font-mono text-[11px] text-slate-400">资料基准：{brand.verifiedAt}</span>
  </div>

  <div class="mt-4 space-y-5">
    <div>
      <h4 class="text-xs font-mono uppercase tracking-wider text-teal-300 mb-2.5">AI 生产力工具可用性（ChatGPT / Claude / Gemini）</h4>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        {aiItems.map(([name, val]) => {
          const st = badgeFor(val);
          return (
            <div class="observatory-subpanel rounded-lg p-3.5">
              <div class="flex items-center justify-between gap-2 mb-1.5">
                <span class="text-sm font-bold text-white">{name}</span>
                <span class={`inline-flex items-center gap-1.5 px-2 py-0.5 rounded border text-[10px] font-mono ${st.cls}`}>
                  <span class={`w-1.5 h-1.5 rounded-full ${st.dot}`}></span>
                  {st.label}
                </span>
              </div>
              <p class="text-xs text-slate-300 leading-relaxed">{val}</p>
            </div>
          );
        })}
      </div>
    </div>

    <div>
      <h4 class="text-xs font-mono uppercase tracking-wider text-sky-300 mb-2.5">流媒体与内容平台可用性（Netflix / Disney+ / YouTube / TikTok 等）</h4>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {streamItems.map(([name, val]) => {
          const st = badgeFor(val);
          return (
            <div class="observatory-subpanel rounded-lg p-3.5">
              <div class="flex items-center justify-between gap-2 mb-1.5">
                <span class="text-sm font-bold text-white">{name}</span>
                <span class={`inline-flex items-center gap-1.5 px-2 py-0.5 rounded border text-[10px] font-mono ${st.cls}`}>
                  <span class={`w-1.5 h-1.5 rounded-full ${st.dot}`}></span>
                  {st.label}
                </span>
              </div>
              <p class="text-xs text-slate-300 leading-relaxed">{val}</p>
            </div>
          );
        })}
      </div>
    </div>
  </div>

  <div class="mt-4 pt-3 border-t border-slate-700/70 flex flex-wrap items-center justify-between gap-2 text-[11px] text-slate-400">
    <span>说明：标注“品牌方宣称支持”的条目来自服务商资料而非独立长期实测，IP 风控变化可能影响实际可用性。</span>
    <span class="font-mono text-slate-500 select-none">机场情报 · jichangqingbao.biz</span>
  </div>
</section>
